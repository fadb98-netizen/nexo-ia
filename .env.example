# Backend (FastAPI) — variables de entorno de servidor. Nunca comitear el
# archivo .env real; este es sólo un template.

# OpenAI — opcional. Si no está configurada, la app funciona igual en modo
# determinístico (los hallazgos calculados por Python, sin interpretación de IA).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase — opcional. Si no están configuradas, la app funciona igual con un
# store en memoria (no persiste corridas entre reinicios del backend).
# Usar la Service Role key acá (nunca la anon key, y nunca en el frontend).
SUPABASE_URL=
SUPABASE_KEY=

# Frontend (Next.js) — URL pública del backend. En local: http://localhost:8000
# En producción: la URL donde esté desplegado el backend (Railway, Render, Fly.io, etc.)
NEXT_PUBLIC_API_URL=http://localhost:8000
